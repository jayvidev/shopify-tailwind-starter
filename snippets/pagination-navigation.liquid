{% doc %}
  Renders numbered pagination. The collection and search templates load pages
  through `collection.ts` instead; this is for blogs, orders and addresses.

  @param {object} paginate - The `paginate` object of the enclosing tag

  @example
  {% render 'pagination-navigation', paginate: paginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class='mt-10 flex justify-center' role='navigation' aria-label='{{ 'general.pagination.label' | t }}'>
    <ol class='flex items-center gap-1'>
      {%- if paginate.previous -%}
        <li>
          <a
            href='{{ paginate.previous.url }}'
            class='flex size-9 items-center justify-center rounded-input border border-border text-fg no-underline transition-colors hover:bg-surface'
            aria-label='{{ 'general.pagination.previous' | t }}'
          >
            {% render 'icon', icon: 'chevron-left', class: 'size-3' %}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a
              href='{{ part.url }}'
              class='flex size-9 items-center justify-center rounded-input border border-border text-sm text-fg no-underline transition-colors hover:bg-surface'
            >
              {{ part.title }}
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <span
              class='flex size-9 items-center justify-center rounded-input border border-fg bg-fg text-sm text-bg'
              aria-current='page'
            >
              {{ part.title }}
            </span>
          {%- else -%}
            <span class='flex size-9 items-center justify-center text-sm text-fg-subtle'>
              {{ part.title }}
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a
            href='{{ paginate.next.url }}'
            class='flex size-9 items-center justify-center rounded-input border border-border text-fg no-underline transition-colors hover:bg-surface'
            aria-label='{{ 'general.pagination.next' | t }}'
          >
            {% render 'icon', icon: 'chevron-right', class: 'size-3' %}
          </a>
        </li>
      {%- endif -%}
    </ol>
  </nav>
{%- endif -%}
