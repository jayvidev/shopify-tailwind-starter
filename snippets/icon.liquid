{% doc %}
  Renders an icon. The whole set is inlined here: one file to edit, nothing extra
  to request.

  @param {string} icon - Icon name. Aliases: menu, user, tag, check, model, chevron-down/up/left/right
  @param {string} [class] - Classes on the <svg>, e.g. 'size-5'

  @example
  {% render 'icon', icon: 'cart', class: 'size-6' %}
{% enddoc %}

{%- liquid
  assign extra_class = class

  case icon
    when 'menu'
      assign icon_name = 'hamburger'
    when 'user'
      assign icon_name = 'account'
    when 'tag'
      assign icon_name = 'price-tag'
    when 'check'
      assign icon_name = 'checkmark'
    when 'model'
      assign icon_name = '3d-model'
    when 'chevron-down'
      assign icon_name = 'caret'
    when 'chevron-right'
      assign icon_name = 'caret'
      assign extra_class = extra_class | append: ' -rotate-90'
    when 'chevron-left'
      assign icon_name = 'caret'
      assign extra_class = extra_class | append: ' rotate-90'
    when 'chevron-up'
      assign icon_name = 'caret'
      assign extra_class = extra_class | append: ' rotate-180'
    else
      assign icon_name = icon
  endcase

  assign class = extra_class
-%}

