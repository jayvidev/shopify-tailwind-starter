{% doc %}
  Renders the desktop navigation from a linklist. Items with children open a
  panel on hover — a narrow dropdown or a full-width mega menu, depending on
  `menu_type`. Three levels of nesting are supported.

  Expects to be rendered inside the header's `x-data`, which owns `hoveredItem`.

  @param {string} menu - Handle of the linklist to render
  @param {string} [menu_type] - 'dropdown' or 'mega'. Defaults to 'dropdown'

  @example
  {% render 'header-menu', menu: section.settings.menu, menu_type: 'mega' %}
{% enddoc %}

{%- assign menu_type = menu_type | default: 'dropdown' -%}

<ul class='header-menu flex items-center gap-1'>
  {%- for link in linklists[menu].links -%}
    {%- liquid
      assign link_handle = link.handle | default: forloop.index
      assign has_children = false
      if link.links != blank
        assign has_children = true
      endif

      assign is_active = false
      if link.active or link.child_active
        assign is_active = true
      endif
    -%}

    <li
      class='{% if menu_type == 'dropdown' and has_children %}relative{% endif %}'
      {% if has_children %}
        @mouseenter="hoveredItem = '{{ link_handle }}'; $store.ui.isMinicartVisible = false; $store.ui.isPredictiveSearchVisible = false"
      {% else %}
        @mouseenter='hoveredItem = null'
      {% endif %}
    >
      <a
        href='{{ link.url }}'
        class='flex items-center gap-1.5 px-3 py-2 text-sm text-fg no-underline decoration-1 underline-offset-4 hover:underline
          {%- if is_active %} underline decoration-1{% endif %}'
        {% if has_children %}
          :aria-expanded="hoveredItem === '{{ link_handle }}' ? 'true' : 'false'"
        {% endif %}
        {% if link.active %}
          aria-current='page'
        {% endif %}
      >
        {{ link.title | escape }}

        {%- if has_children -%}
          <span
            class='inline-block transition-transform duration-300'
            :class="{ 'rotate-180': hoveredItem === '{{ link_handle }}' }"
          >
            {% render 'icon', icon: 'chevron-down', class: 'size-2.5' %}
          </span>
        {%- endif -%}
      </a>

      {%- if has_children -%}
        {% render 'header-menu-panel', link: link, link_handle: link_handle, menu_type: menu_type %}
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
