{% doc %}
  Renders the predictive search panel.

  The `<predictive-search>` element (`src/elements/predictive-search.ts`) debounces
  the input and swaps in the `predictive-search-results` section, so results are
  rendered by Liquid rather than assembled in JS.

  @example
  {% render 'predictive-search' %}
{% enddoc %}

<predictive-search
  id='predictive-search'
  class='absolute inset-x-0 top-full z-120 flex max-h-[calc(100dvh-4rem)] flex-col overflow-hidden border-t border-border bg-bg md:max-h-[calc(100dvh-5rem)]'
  x-data='{ searchTerms: {{ search.terms | default: '' | json }} }'
  x-show='$store.ui.isPredictiveSearchVisible'
  x-trap.inert.noautofocus='$store.ui.isPredictiveSearchVisible'
  x-effect='if ($store.ui.isPredictiveSearchVisible) $refs.searchInput.focus()'
  x-transition:enter='transition ease-out duration-200'
  x-transition:enter-start='opacity-0 -translate-y-2'
  x-transition:enter-end='opacity-100 translate-y-0'
  x-transition:leave='transition ease-in duration-150'
  x-transition:leave-start='opacity-100 translate-y-0'
  x-transition:leave-end='opacity-0 -translate-y-2'
  @keyup.escape='$store.ui.isPredictiveSearchVisible = false'
  tabindex='-1'
  aria-modal='true'
  x-cloak
>
  <form
    id='predictive-search-form'
    action='{{ routes.search_url }}'
    method='get'
    role='search'
    class='page flex min-h-0 flex-1 flex-col py-4'
  >
    <div class='field-focus flex h-11 items-center gap-3 rounded-input border border-border px-4'>
      {% render 'icon', icon: 'search', class: 'size-4 shrink-0 text-fg-subtle' %}

      <label class='sr-only' for='predictive-search-input'>
        {{ 'general.search.search' | t }}
      </label>
      <input
        id='predictive-search-input'
        x-ref='searchInput'
        x-model='searchTerms'
        class='w-full border-none bg-transparent text-sm placeholder:text-fg-subtle focus:outline-none'
        type='search'
        name='q'
        value='{{ search.terms | escape }}'
        placeholder='{{ 'general.search.search' | t }}'
        role='combobox'
        aria-expanded='false'
        aria-controls='predictive-search-target'
        aria-haspopup='listbox'
        aria-autocomplete='list'
        autocomplete='off'
      >

      <button
        type='button'
        class='flex cursor-pointer items-center text-fg-subtle transition-colors hover:text-fg'
        x-show='searchTerms.length > 0'
        @click="searchTerms = ''; $refs.searchInput.focus()"
        x-cloak
      >
        <span class='sr-only'>{{ 'general.search.reset' | t }}</span>
        {% render 'icon', icon: 'close', class: 'size-4' %}
      </button>
    </div>

    <input name='type' type='hidden' value='product'>
    <input name='options[prefix]' type='hidden' value='last'>

    <div
      id='predictive-search-target'
      class='min-h-0 flex-1 overflow-y-auto'
      tabindex='-1'
    ></div>
  </form>
</predictive-search>

{% stylesheet %}
  /* The native clear button duplicates our own. */
  #predictive-search-input::-webkit-search-decoration,
  #predictive-search-input::-webkit-search-cancel-button,
  #predictive-search-input::-webkit-search-results-button,
  #predictive-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
  }
{% endstylesheet %}
