<!doctype html>
<html lang='{{ request.locale.iso_code }}' class='no-js'>
  <head>
    {% render 'head-meta' %}

    {%- if settings.favicon != blank -%}
      <link rel='icon' href='{{ settings.favicon | image_url: width: 32, height: 32 }}'>
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {{ content_for_header }}

    {% render 'head-css' %}
    {% render 'head-scripts' %}
    {% render 'font-face' %}
    {% render 'assets-tag', file: 'theme.css' %}
    {% render 'assets-tag', file: 'theme.js' %}
  </head>

  <body class='password-template antialiased' x-data>
    {{ content_for_layout }}
  </body>
</html>
