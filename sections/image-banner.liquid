
<div class='banner-media relative flex min-h-112 items-center justify-center overflow-hidden md:min-h-136'>
  {%- if section.settings.image != blank -%}
    {%- assign banner_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
    {{
      section.settings.image
      | image_url: width: 3000
      | image_tag:
        alt: banner_alt,
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
        class: 'banner-media__image absolute inset-0 size-full object-cover'
    }}
  {%- else -%}
    <div class='absolute inset-0 bg-surface'></div>
  {%- endif -%}

  {%- comment -%} Overlay keeps the copy legible over any photo. {%- endcomment -%}
  <div class='absolute inset-0 bg-fg/20'></div>

  <div class='page relative flex flex-col items-center justify-center py-16 text-center'>
    <div class='flex max-w-2xl flex-col items-center gap-4'>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class='text-3xl font-semibold text-bg md:text-4xl lg:text-5xl' {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class='prose text-bg **:text-bg' {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'button' -%}
            <div class='flex flex-wrap gap-3' {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                {% render 'button',
                  label: block.settings.label,
                  href: block.settings.link,
                  size: 'lg'
                %}
              {%- endif -%}
              {%- if block.settings.secondary_label != blank -%}
                {% render 'button',
                  label: block.settings.secondary_label,
                  href: block.settings.secondary_link,
                  variant: 'outline',
                  size: 'lg'
                %}
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /*
    The image is pinned to the viewport and clipped to the section, which is what
    reads as parallax while the page scrolls past it.
  */
  .banner-media {
    clip-path: inset(0);
  }

  .banner-media .banner-media__image {
    position: fixed;
    inset: 0;
    height: 100vh;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Image banner",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Give customers details about the banner image or content on the template.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Shop all",
          "label": "First button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "First button link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Second button label"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
