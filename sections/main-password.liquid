<div class='page flex min-h-dvh flex-col items-center justify-center gap-8 py-16 text-center'>
  <a href='{{ routes.root_url }}' class='no-underline'>
    {% render 'header-logo' %}
  </a>

  {%- if section.settings.heading != blank -%}
    <h1 class='text-2xl font-semibold md:text-3xl'>{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class='prose max-w-lg text-center'>{{ section.settings.text }}</div>
  {%- endif -%}

  <div class='w-full max-w-sm'>
    {%- form 'storefront_password', class: 'flex flex-col gap-3' -%}
      {%- assign password_label = 'general.password_page.login_form_password_label' | t -%}
      {% render 'form-input',
        id: 'storefront-password',
        name: 'password',
        type: 'password',
        label: password_label,
        required: true
      %}

      {%- if form.errors -%}
        <p class='text-sm text-error'>
          {{ 'general.password_page.login_form_error' | t }}
        </p>
      {%- endif -%}

      {%- assign submit_label = 'general.password_page.login_form_submit' | t -%}
      {% render 'button', label: submit_label, type: 'submit', full: true %}
    {%- endform -%}
  </div>

  <p class='text-sm text-fg-subtle'>
    {{ 'general.password_page.admin_link_html' | t }}
  </p>
</div>

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Opening soon",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Be the first to know when we launch.</p>",
      "label": "Text"
    }
  ]
}
{% endschema %}
