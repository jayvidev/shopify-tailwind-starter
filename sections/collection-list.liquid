<div class='page section-spacing'>
  {%- if section.settings.heading != blank -%}
    <h2 class='mb-6 text-2xl font-semibold md:text-3xl'>{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class='grid grid-gap grid-cols-2 md:grid-cols-3'>
      {%- for block in section.blocks -%}
        {%- liquid
          # A `collection` setting hands back the collection itself, not its handle.
          assign block_collection = block.settings.collection
          assign card_image = block.settings.image | default: block_collection.featured_image
          assign card_alt = card_image.alt | default: block_collection.title | escape
          assign block_url = block_collection.url | default: routes.all_products_collection_url
          assign block_title = block_collection.title | default: 'onboarding.collection_title' | t
        -%}
        <a
          href='{{ block_url }}'
          class='group flex flex-col no-underline'
          {{ block.shopify_attributes }}
        >
          <div class='mb-3 aspect-square overflow-hidden rounded-media bg-surface'>
            {%- if card_image -%}
              {{
                card_image
                | image_url: width: 1000
                | image_tag:
                  alt: card_alt,
                  loading: 'lazy',
                  sizes: '(min-width: 768px) 33vw, 50vw',
                  widths: '300, 500, 700, 1000',
                  class: 'size-full object-cover transition-transform duration-500 group-hover:scale-105'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'size-full object-cover opacity-40' }}
            {%- endif -%}
          </div>

          <h3 class='text-sm font-medium text-fg underline-offset-4 group-hover:underline md:text-base'>
            {{ block_title }}
          </h3>
          {%- if block_collection.title != blank -%}
            <p class='text-xs text-fg-subtle'>
              {{ 'products.facets.product_count_simple' | t: count: block_collection.all_products_count }}
            </p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Collections",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
