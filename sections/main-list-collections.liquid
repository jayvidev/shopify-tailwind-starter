<div class='page section-spacing'>
  <h1 class='mb-8 text-2xl font-semibold md:text-3xl'>
    {{ page_title }}
  </h1>

  <div class='grid grid-gap grid-cols-2 md:grid-cols-3'>
    {%- for collection in collections -%}
      {%- assign card_alt = collection.featured_image.alt | default: collection.title | escape -%}
      <a href='{{ collection.url }}' class='group flex flex-col no-underline'>
        <div class='mb-3 aspect-square overflow-hidden rounded-media bg-surface'>
          {%- if collection.featured_image -%}
            {{
              collection.featured_image
              | image_url: width: 1000
              | image_tag:
                alt: card_alt,
                loading: 'lazy',
                sizes: '(min-width: 768px) 33vw, 50vw',
                widths: '300, 500, 700, 1000',
                class: 'size-full object-cover transition-transform duration-500 group-hover:scale-105'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'size-full object-cover opacity-40' }}
          {%- endif -%}
        </div>
        <h2 class='text-sm font-medium underline-offset-4 group-hover:underline md:text-base'>
          {{ collection.title }}
        </h2>
        <p class='text-xs text-fg-subtle'>
          {{ 'products.facets.product_count_simple' | t: count: collection.all_products_count }}
        </p>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "tag": "section",
  "settings": []
}
{% endschema %}
