{%- liquid
  assign menu = section.settings.menu
  assign menu_type = section.settings.menu_type_desktop
-%}

<div
  class='header-container relative border-b border-border bg-bg'
  x-data='{ hoveredItem: null }'
  x-init="$watch('hoveredItem', (value) => ($store.ui.isMegaMenuVisible = !!value))"
  @close-mega-menu.window='hoveredItem = null'
  @mouseleave='hoveredItem = null'
>
  <div class='page flex h-16 items-center justify-between gap-4 md:h-20'>
    {%- comment -%} Left: mobile menu toggle, desktop nav when the logo is centred {%- endcomment -%}
    <div class='flex flex-1 items-center justify-start'>
      <button
        type='button'
        class='-ms-3 flex size-11 cursor-pointer items-center justify-center lg:hidden'
        @click='$store.ui.toggleMobileMenu(); $store.ui.isPredictiveSearchVisible = false; $store.ui.isMinicartVisible = false; hoveredItem = null'
        :aria-expanded="$store.ui.isMobileMenuVisible ? 'true' : 'false'"
        aria-controls='mobile-menu'
        aria-label='{{ 'sections.header.menu' | t }}'
      >
        <span x-show='!$store.ui.isMobileMenuVisible'>
          {% render 'icon', icon: 'menu', class: 'size-5' %}
        </span>
        <span x-show='$store.ui.isMobileMenuVisible' x-cloak>
          {% render 'icon', icon: 'close', class: 'size-5' %}
        </span>
      </button>

      <a
        href='{{ routes.root_url }}'
        class='hidden shrink-0 items-center no-underline lg:flex'
      >
        {% render 'header-logo' %}
      </a>
    </div>

    {%- comment -%} The logo moves to the middle on mobile, where there's no nav. {%- endcomment -%}
    <div class='flex shrink-0 items-center justify-center lg:hidden'>
      <a
        href='{{ routes.root_url }}'
        class='flex items-center no-underline'
      >
        {% render 'header-logo' %}
      </a>
    </div>

    <div class='hidden flex-1 justify-center lg:flex'>
      {% render 'header-menu', menu: menu, menu_type: menu_type %}
    </div>

    {%- comment -%} Right: search, account, cart {%- endcomment -%}
    <div class='flex flex-1 items-center justify-end'>
      {%- if settings.predictive_search_enabled -%}
        <button
          type='button'
          class='flex size-11 cursor-pointer items-center justify-center'
          @click='$store.ui.isPredictiveSearchVisible = true; $store.ui.isMobileMenuVisible = false; $store.ui.isMinicartVisible = false; hoveredItem = null'
          :aria-expanded="$store.ui.isPredictiveSearchVisible ? 'true' : 'false'"
          aria-controls='predictive-search'
          aria-label='{{ 'general.search.search' | t }}'
        >
          {% render 'icon', icon: 'search', class: 'size-5' %}
        </button>
      {%- else -%}
        <a
          href='{{ routes.search_url }}'
          class='flex size-11 items-center justify-center'
          aria-label='{{ 'general.search.search' | t }}'
        >
          {% render 'icon', icon: 'search', class: 'size-5' %}
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a
          href='{{ routes.account_url }}'
          class='hidden size-11 items-center justify-center md:flex'
          aria-label='{{ 'customer.log_in' | t }}'
        >
          {% render 'icon', icon: 'user', class: 'size-5' %}
        </a>
      {%- endif -%}

      <button
        type='button'
        class='relative -me-3 flex size-11 cursor-pointer items-center justify-center'
        @click='$store.ui.isMinicartVisible = true; $store.ui.isMobileMenuVisible = false; $store.ui.isPredictiveSearchVisible = false; hoveredItem = null'
        aria-label='{{ 'templates.cart.cart' | t }}'
        aria-controls='minicart'
      >
        {%- comment -%}
          Two icons, one shown at a time: the closed bag once there's something in
          the cart. `$store.cart` is populated from the initial cart state, and the
          Liquid value covers the frame before Alpine starts.
        {%- endcomment -%}
        {%- liquid
          assign cart_has_items = false
          if cart.item_count > 0
            assign cart_has_items = true
          endif
        -%}
        <span
          x-data='{
            get hasItems() {
              return $store.cart.cart
                ? $store.cart.cart.item_count > 0
                : {{ cart_has_items | json }}
            }
          }'
        >
          <span x-show='!hasItems' {% if cart_has_items %}x-cloak{% endif %}>
            {% render 'icon', icon: 'cart-empty', class: 'size-11' %}
          </span>
          <span x-show='hasItems' {% unless cart_has_items %}x-cloak{% endunless %}>
            {% render 'icon', icon: 'cart', class: 'size-11' %}
          </span>

          {%- comment -%} Same offsets as Dawn: 17px bubble, 8px up, 22px in. {%- endcomment -%}
          <span
            data-ajax-cart-bind='item_count'
            class='cart-count-badge absolute bottom-2 inset-s-5.5 flex size-[1.0625rem] items-center justify-center rounded-full bg-fg text-[0.5625rem] font-semibold text-bg'
          >
            {{- cart.item_count -}}
          </span>
        </span>
      </button>
    </div>
  </div>

  {% render 'mobile-menu', menu: menu %}

  {%- if settings.predictive_search_enabled -%}
    {% render 'predictive-search' %}
    <script src='{{ 'predictive-search.js' | asset_url }}' defer='defer'></script>
  {%- endif -%}

</div>

{% stylesheet %}
  /* liquid-ajax-cart marks the document while the cart is empty. */
  .js-ajax-cart-empty .cart-count-badge {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "section-header sticky top-0 z-100",
  "tag": "header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "select",
      "id": "menu_type_desktop",
      "default": "dropdown",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "mega",
          "label": "Mega menu"
        }
      ],
      "label": "Desktop menu type",
      "info": "Both are built from the nesting of the menu you selected — up to three levels."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "default": true,
      "label": "Show account link"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
