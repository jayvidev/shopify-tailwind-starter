{%- comment -%}
  Collection page: banner, then the shared filter/grid snippet.

  `x-data='collection(...)'` passes the section id so filtering, sorting and
  load-more can re-render this section alone through the Section Rendering API.
  `handleLinkClick` intercepts pagination and clear-filter links for the same
  reason — see `src/alpine/components/collection.ts`.
{%- endcomment -%}

<div
  class='page section-spacing'
  x-data='collection({ sectionId: "{{ section.id }}" })'
  @click='handleLinkClick($event)'
>
  <div class='mb-8 flex flex-col items-center gap-3 text-center'>
    <h1 class='text-3xl font-semibold md:text-4xl lg:text-5xl'>{{ collection.title }}</h1>

    {%- if collection.description != blank -%}
      <div class='prose max-w-3xl text-center'>{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {% render 'product-grid-filters',
      products: collection.products,
      filters: collection.filters,
      paginate: paginate,
      sort_options: collection.sort_options,
      sort_selected: collection.sort_by,
      results_url: collection.url,
      form_id_prefix: 'Collection'
    %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
