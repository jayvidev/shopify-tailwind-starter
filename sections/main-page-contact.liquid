<div class='page section-spacing'>
  <div class='mx-auto max-w-2xl'>
    <h1 class='mb-4 text-2xl font-semibold md:text-3xl'>{{ page.title }}</h1>

    {%- if page.content != blank -%}
      <div class='prose mb-8'>{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'flex flex-col gap-4' -%}
      {%- if form.posted_successfully? -%}
        <p class='rounded-input border border-border bg-surface px-4 py-3 text-sm text-success'>
          {{ 'templates.contact.form.post_success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class='rounded-input border border-border bg-surface px-4 py-3 text-sm text-error'>
          <p class='font-medium'>{{ 'templates.contact.form.error_heading' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class='grid grid-cols-1 gap-4 md:grid-cols-2'>
        {%- assign name_label = 'templates.contact.form.name' | t -%}
        {%- assign email_label = 'templates.contact.form.email' | t -%}
        {% render 'form-input',
          id: 'contact-name',
          name: 'contact[name]',
          label: name_label,
          placeholder: name_label,
          value: form.name
        %}
        {% render 'form-input',
          id: 'contact-email',
          name: 'contact[email]',
          type: 'email',
          label: email_label,
          placeholder: email_label,
          value: form.email,
          required: true
        %}
      </div>

      {%- assign phone_label = 'templates.contact.form.phone' | t -%}
      {% render 'form-input',
        id: 'contact-phone',
        name: 'contact[phone]',
        type: 'tel',
        label: phone_label,
        placeholder: phone_label
      %}

      {%- assign comment_label = 'templates.contact.form.comment' | t -%}
      {% render 'form-textarea',
        id: 'contact-body',
        name: 'contact[body]',
        label: comment_label,
        placeholder: comment_label,
        value: form.body,
        rows: 5,
        required: true
      %}

      {%- assign send_label = 'templates.contact.form.send' | t -%}
      {% render 'button', label: send_label, type: 'submit', class: 'w-max' %}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "class": "section-main-page-contact",
  "tag": "section"
}
{% endschema %}
