{%- comment -%}
  Slideshow built on scroll snapping plus `slider` for the arrows and dots — no
  transform maths, so it degrades to a swipeable strip without JS.
{%- endcomment -%}

<div
  class='relative'
  x-data='slider'
  @resize.window.debounce.100ms='updateScroll()'
>
  <div
    class='flex snap-x snap-mandatory overflow-x-auto scroll-smooth'
    x-ref='slider'
    @scroll.passive='updateScroll()'
  >
    {%- for block in section.blocks -%}
      <div
        class='relative w-full shrink-0 snap-start'
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign slide_alt = block.settings.image.alt | default: block.settings.heading | escape
            if forloop.first
              assign slide_loading = 'eager'
            else
              assign slide_loading = 'lazy'
            endif
          -%}
          {{
            block.settings.image
            | image_url: width: 3000
            | image_tag:
              alt: slide_alt,
              loading: slide_loading,
              sizes: '100vw',
              widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
              class: 'h-[24rem] w-full object-cover md:h-[36rem]'
          }}
        {%- else -%}
          <div class='h-96 w-full bg-surface md:h-144'></div>
        {%- endif -%}

        <div class='absolute inset-0 bg-fg/20'></div>

        <div class='absolute inset-0 flex items-center'>
          <div class='page flex flex-col items-start gap-4 text-bg'>
            {%- if block.settings.heading != blank -%}
              <h2 class='max-w-xl text-3xl font-semibold md:text-4xl lg:text-5xl'>
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class='max-w-xl text-base md:text-lg'>{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              {% render 'button', label: block.settings.label, href: block.settings.link, size: 'lg' %}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {% render 'slider-navigation', show_dots: true, class: 'md:size-11' %}
</div>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Slide heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Shop now",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
