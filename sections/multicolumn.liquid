<div class='page section-spacing'>
  {%- if section.settings.heading != blank -%}
    <h2 class='mb-8 text-center text-2xl font-semibold md:text-3xl'>{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class='grid gap-8 grid-cols-1 md:grid-cols-3'>
    {%- for block in section.blocks -%}
      <div
        class='flex flex-col items-center gap-3 text-center'
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {%- assign column_alt = block.settings.image.alt | default: block.settings.heading | escape -%}
          <div class='aspect-[4/3] w-full overflow-hidden rounded-media bg-surface'>
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                alt: column_alt,
                loading: 'lazy',
                sizes: '(min-width: 768px) 33vw, 100vw',
                widths: '300, 500, 700, 1000',
                class: 'size-full object-cover'
            }}
          </div>
        {%- endif -%}

        {%- if block.settings.heading != blank -%}
          <h3 class='text-base font-semibold'>{{ block.settings.heading }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class='prose text-center'>{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <a
            href='{{ block.settings.link }}'
            class='text-sm font-medium text-fg underline underline-offset-4'
          >
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Multicolumn",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Column",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product.</p>",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
