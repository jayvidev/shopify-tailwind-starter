{%- comment -%}
  Search results page. Reuses the collection filter/grid snippet, so filtering,
  sorting and load-more behave exactly as they do on a collection.
{%- endcomment -%}

<div
  class='page section-spacing'
  x-data='collection({ sectionId: "{{ section.id }}" })'
  @click='handleLinkClick($event)'
>
  <div class='mb-8 flex flex-col items-center gap-4 text-center'>
    <h1 class='text-3xl font-semibold md:text-4xl'>
      {%- if search.performed -%}
        {{ 'templates.search.search_for' | t: terms: search.terms }}
      {%- else -%}
        {{ 'templates.search.title' | t }}
      {%- endif -%}
    </h1>

    <form
      action='{{ routes.search_url }}'
      method='get'
      role='search'
      class='flex w-full max-w-lg items-center gap-2'
    >
      <div class='flex-1'>
        <label class='sr-only' for='search-page-input'>{{ 'general.search.search' | t }}</label>
        <input
          id='search-page-input'
          type='search'
          name='q'
          value='{{ search.terms | escape }}'
          placeholder='{{ 'general.search.search' | t }}'
          class='h-11 w-full rounded-input border border-border bg-bg px-4 text-sm placeholder:text-fg-subtle'
        >
      </div>
      <input type='hidden' name='options[prefix]' value='last'>
      {%- assign search_label = 'general.search.search' | t -%}
      {% render 'button', label: search_label, type: 'submit', class: 'h-11! py-0!' %}
    </form>

    {%- if search.performed -%}
      <p class='text-sm text-fg-subtle'>
        {{ 'templates.search.results_with_count' | t: count: search.results_count }}
      </p>
    {%- endif -%}
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.products_per_page -%}
      {% render 'product-grid-filters',
        products: search.results,
        filters: search.filters,
        paginate: paginate,
        sort_options: search.sort_options,
        sort_selected: search.sort_by,
        results_url: routes.search_url,
        form_id_prefix: 'Search'
      %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Results per page"
    }
  ]
}
{% endschema %}
