{%- liquid
  # A `collection` setting hands back the collection itself, not its handle —
  # `collections[…]` on it returns an empty drop.
  assign featured_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show

-%}

<div class='page section-spacing'>
  <div class='mb-6 flex flex-wrap items-end justify-between gap-3'>
    <div class='flex flex-col gap-2'>
      {%- if section.settings.heading != blank -%}
        <h2 class='text-2xl font-semibold md:text-3xl'>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class='prose'>{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and featured_collection.all_products_count > products_to_show -%}
      {%- assign view_all_label = 'sections.featured_collection.view_all' | t -%}
      {% render 'button',
        label: view_all_label,
        href: featured_collection.url,
        variant: 'outline',
        size: 'sm'
      %}
    {%- endif -%}
  </div>

  {%- if featured_collection.products.size > 0 -%}
    <div class='grid grid-gap grid-cols-2 md:grid-cols-3 lg:grid-cols-4'>
      {%- for product in featured_collection.products limit: products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%}
      Placeholders until a collection is picked, so the section is visible in the
      editor instead of looking broken.
    {%- endcomment -%}
    <div class='grid grid-gap grid-cols-2 md:grid-cols-3 lg:grid-cols-4'>
      {%- for i in (1..products_to_show) -%}
        <div class='flex flex-col'>
          <div class='mb-3 aspect-square overflow-hidden rounded-media bg-surface'>
            {{ 'product-1' | placeholder_svg_tag: 'size-full object-cover opacity-40' }}
          </div>
          <p class='text-sm font-medium'>{{ 'onboarding.product_title' | t }}</p>
          <p class='text-sm text-fg-subtle'>{{ 1999 | money }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show \"View all\""
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
