<div class='page section-spacing'>
  <div class='mx-auto max-w-sm'>
    <h1 class='mb-6 text-2xl font-semibold'>{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', class: 'flex flex-col gap-4' -%}
      {{ form.errors | default_errors }}

      {%- assign first_name_label = 'customer.register.first_name' | t -%}
      {%- assign last_name_label = 'customer.register.last_name' | t -%}
      {%- assign email_label = 'customer.register.email' | t -%}
      {%- assign password_label = 'customer.register.password' | t -%}

      {% render 'form-input',
        id: 'register-first-name',
        name: 'customer[first_name]',
        label: first_name_label
      %}
      {% render 'form-input',
        id: 'register-last-name',
        name: 'customer[last_name]',
        label: last_name_label
      %}
      {% render 'form-input',
        id: 'register-email',
        name: 'customer[email]',
        type: 'email',
        label: email_label,
        required: true
      %}
      {% render 'form-input',
        id: 'register-password',
        name: 'customer[password]',
        type: 'password',
        label: password_label,
        required: true
      %}

      {%- assign submit_label = 'customer.register.submit' | t -%}
      {% render 'button', label: submit_label, type: 'submit', full: true %}
    {%- endform -%}

    <a
      href='{{ routes.account_login_url }}'
      class='mt-4 inline-block text-sm text-fg underline underline-offset-4'
    >
      {{ 'customer.log_in' | t }}
    </a>
  </div>
</div>
