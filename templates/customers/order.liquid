<div class='page section-spacing'>
  <a
    href='{{ routes.account_url }}'
    class='mb-6 inline-block text-sm text-fg underline underline-offset-4'
  >
    {{ 'customer.account.return' | t }}
  </a>

  <h1 class='mb-1 text-2xl font-semibold md:text-3xl'>
    {{ 'customer.order.title' | t: name: order.name }}
  </h1>
  <p class='mb-8 text-sm text-fg-subtle'>
    {{ 'customer.order.date_html' | t: date: order.created_at | date: format: 'date_at_time' }}
  </p>

  <div class='grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_18rem]'>
    <div class='overflow-x-auto'>
      <table class='w-full text-sm'>
        <thead class='border-b border-border text-xs uppercase tracking-wide text-fg-subtle'>
          <tr>
            <th class='py-2 text-start'>{{ 'customer.order.product' | t }}</th>
            <th class='py-2 text-start'>{{ 'customer.order.price' | t }}</th>
            <th class='py-2 text-start'>{{ 'customer.order.quantity' | t }}</th>
            <th class='py-2 text-end'>{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr class='border-b border-border'>
              <td class='py-3'>
                <a href='{{ line_item.product.url }}' class='text-fg underline underline-offset-4'>
                  {{ line_item.title }}
                </a>
              </td>
              <td class='py-3'>{{ line_item.price | money }}</td>
              <td class='py-3'>{{ line_item.quantity }}</td>
              <td class='py-3 text-end'>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan='3' class='py-2 text-end'>{{ 'customer.order.subtotal' | t }}</td>
            <td class='py-2 text-end'>{{ order.line_items_subtotal_price | money }}</td>
          </tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr>
              <td colspan='3' class='py-2 text-end'>{{ 'customer.order.shipping' | t }}</td>
              <td class='py-2 text-end'>{{ shipping_method.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr>
              <td colspan='3' class='py-2 text-end'>{{ 'customer.order.tax' | t }}</td>
              <td class='py-2 text-end'>{{ tax_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          <tr class='font-semibold'>
            <td colspan='3' class='py-2 text-end'>{{ 'customer.order.total' | t }}</td>
            <td class='py-2 text-end'>{{ order.total_net_amount | money }}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <aside class='flex flex-col gap-6'>
      <div class='rounded-card border border-border p-5'>
        <h2 class='mb-2 text-base font-semibold'>{{ 'customer.order.billing_address' | t }}</h2>
        <p class='text-sm text-fg-subtle'>
          {{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}
        </p>
        <div class='mt-2 text-sm text-fg-muted'>
          {{ order.billing_address | format_address }}
        </div>
      </div>

      <div class='rounded-card border border-border p-5'>
        <h2 class='mb-2 text-base font-semibold'>{{ 'customer.order.shipping_address' | t }}</h2>
        <p class='text-sm text-fg-subtle'>
          {{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}
        </p>
        <div class='mt-2 text-sm text-fg-muted'>
          {{ order.shipping_address | format_address }}
        </div>
      </div>
    </aside>
  </div>
</div>
