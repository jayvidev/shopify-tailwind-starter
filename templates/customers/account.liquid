<div class='page section-spacing'>
  <div class='mb-8 flex flex-wrap items-center justify-between gap-3'>
    <h1 class='text-2xl font-semibold md:text-3xl'>{{ 'customer.account.title' | t }}</h1>
    <a href='{{ routes.account_logout_url }}' class='text-sm text-fg underline underline-offset-4'>
      {{ 'customer.log_out' | t }}
    </a>
  </div>

  <div class='grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_18rem]'>
    <div>
      <h2 class='mb-4 text-lg font-semibold'>{{ 'customer.orders.title' | t }}</h2>

      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class='overflow-x-auto'>
            <table class='w-full text-sm'>
              <thead class='border-b border-border text-start text-xs uppercase tracking-wide text-fg-subtle'>
                <tr>
                  <th class='py-2 text-start'>{{ 'customer.orders.order_number' | t }}</th>
                  <th class='py-2 text-start'>{{ 'customer.orders.date' | t }}</th>
                  <th class='py-2 text-start'>{{ 'customer.orders.payment_status' | t }}</th>
                  <th class='py-2 text-start'>{{ 'customer.orders.fulfillment_status' | t }}</th>
                  <th class='py-2 text-end'>{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr class='border-b border-border'>
                    <td class='py-3'>
                      <a href='{{ order.customer_url }}' class='text-fg underline underline-offset-4'>
                        {{ order.name }}
                      </a>
                    </td>
                    <td class='py-3'>{{ order.created_at | date: format: 'abbreviated_date' }}</td>
                    <td class='py-3'>{{ order.financial_status_label }}</td>
                    <td class='py-3'>{{ order.fulfillment_status_label }}</td>
                    <td class='py-3 text-end'>{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          {% render 'pagination-navigation', paginate: paginate %}
        {%- else -%}
          <p class='text-sm text-fg-subtle'>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class='rounded-card border border-border p-5'>
      <h2 class='mb-3 text-base font-semibold'>{{ 'customer.account.details' | t }}</h2>
      <div class='text-sm text-fg-muted'>
        {{ customer.default_address.name }}
        {{ customer.default_address | format_address }}
      </div>
      <a
        href='{{ routes.account_addresses_url }}'
        class='mt-3 inline-block text-sm text-fg underline underline-offset-4'
      >
        {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
      </a>
    </aside>
  </div>
</div>
