{%- comment -%}
  Login, with the password-recovery form in the same view — Alpine swaps between
  the two so a forgotten password doesn't cost a page load.
{%- endcomment -%}

<div class='page section-spacing'>
  <div class='mx-auto max-w-sm' x-data='{ recovering: {{ form.errors | default: false | json }} }'>
    <div x-show='!recovering'>
      <h1 class='mb-6 text-2xl font-semibold'>{{ 'customer.login_page.title' | t }}</h1>

      {%- form 'customer_login', return_to: routes.account_url, class: 'flex flex-col gap-4' -%}
        {{ form.errors | default_errors }}

        {%- assign email_label = 'customer.login_page.email' | t -%}
        {%- assign password_label = 'customer.login_page.password' | t -%}
        {% render 'form-input',
          id: 'login-email',
          name: 'customer[email]',
          type: 'email',
          label: email_label,
          required: true
        %}
        {% render 'form-input',
          id: 'login-password',
          name: 'customer[password]',
          type: 'password',
          label: password_label,
          required: true
        %}

        {%- assign sign_in_label = 'customer.login_page.sign_in' | t -%}
        {% render 'button', label: sign_in_label, type: 'submit', full: true %}
      {%- endform -%}

      <div class='mt-4 flex flex-col gap-2 text-sm'>
        <button
          type='button'
          class='w-max cursor-pointer text-fg underline underline-offset-4'
          @click='recovering = true'
        >
          {{ 'customer.login_page.forgot_password' | t }}
        </button>
        <a href='{{ routes.account_register_url }}' class='w-max text-fg underline underline-offset-4'>
          {{ 'customer.login_page.create_account' | t }}
        </a>
      </div>
    </div>

    <div x-show='recovering' x-cloak>
      <h1 class='mb-6 text-2xl font-semibold'>{{ 'customer.recover_password.title' | t }}</h1>

      {%- form 'recover_customer_password', class: 'flex flex-col gap-4' -%}
        {{ form.errors | default_errors }}

        {%- if form.posted_successfully? -%}
          <p class='text-sm text-success'>{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}

        <p class='text-sm text-fg-muted'>{{ 'customer.recover_password.subtext' | t }}</p>

        {%- assign recover_email_label = 'customer.login_page.email' | t -%}
        {% render 'form-input',
          id: 'recover-email',
          name: 'email',
          type: 'email',
          label: recover_email_label,
          required: true
        %}

        {%- assign submit_label = 'customer.login_page.submit' | t -%}
        {% render 'button', label: submit_label, type: 'submit', full: true %}
      {%- endform -%}

      <button
        type='button'
        class='mt-4 cursor-pointer text-sm text-fg underline underline-offset-4'
        @click='recovering = false'
      >
        {{ 'customer.login_page.cancel' | t }}
      </button>
    </div>
  </div>
</div>
