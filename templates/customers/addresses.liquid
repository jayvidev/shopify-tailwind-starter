{%- comment -%}
  Addresses. Each address gets its own edit form, shown in place — `openAddress`
  holds the id of whichever is open, so only one form is expanded at a time.
{%- endcomment -%}

<div class='page section-spacing' x-data='{ openAddress: null, addingAddress: false }'>
  <a
    href='{{ routes.account_url }}'
    class='mb-6 inline-block text-sm text-fg underline underline-offset-4'
  >
    {{ 'customer.account.return' | t }}
  </a>

  <div class='mb-6 flex flex-wrap items-center justify-between gap-3'>
    <h1 class='text-2xl font-semibold md:text-3xl'>{{ 'customer.addresses.title' | t }}</h1>
    {%- assign add_new_label = 'customer.addresses.add_new' | t -%}
    {% render 'button',
      label: add_new_label,
      type: 'button',
      variant: 'outline',
      size: 'sm',
      click_expr: 'addingAddress = !addingAddress'
    %}
  </div>

  <div class='mb-8' x-show='addingAddress' x-collapse x-cloak>
    <div class='rounded-card border border-border p-5'>
      {%- form 'customer_address', customer.new_address, class: 'flex flex-col gap-4' -%}
        {% render 'address-fields', form: form %}
        {%- assign add_label = 'customer.addresses.add' | t -%}
        {%- assign cancel_label = 'customer.addresses.cancel' | t -%}
        <div class='flex gap-2'>
          {% render 'button', label: add_label, type: 'submit' %}
          {% render 'button',
            label: cancel_label,
            type: 'button',
            variant: 'ghost',
            click_expr: 'addingAddress = false'
          %}
        </div>
      {%- endform -%}
    </div>
  </div>

  {%- paginate customer.addresses by 10 -%}
    <ul class='flex flex-col gap-4'>
      {%- for address in customer.addresses -%}
        <li class='rounded-card border border-border p-5'>
          {%- if address == customer.default_address -%}
            {%- assign default_label = 'customer.addresses.default' | t -%}
            {% render 'badge', label: default_label, variant: 'muted', class: 'mb-2' %}
          {%- endif -%}

          <div class='text-sm text-fg-muted'>{{ address | format_address }}</div>

          <div class='mt-3 flex gap-3 text-sm'>
            <button
              type='button'
              class='cursor-pointer text-fg underline underline-offset-4'
              @click='openAddress = openAddress === {{ address.id }} ? null : {{ address.id }}'
            >
              {{ 'customer.addresses.edit' | t }}
            </button>
            <button
              type='button'
              class='cursor-pointer text-error underline underline-offset-4'
              onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')"
              data-target='{{ address.url }}'
              form='address-delete-{{ address.id }}'
            >
              {{ 'customer.addresses.delete' | t }}
            </button>
          </div>

          {%- form 'customer_address', address, id: address_delete_form_id -%}{%- endform -%}

          <div x-show='openAddress === {{ address.id }}' x-collapse x-cloak>
            <div class='mt-4 border-t border-border pt-4'>
              {%- form 'customer_address', address, class: 'flex flex-col gap-4' -%}
                {% render 'address-fields', form: form %}
                {%- assign update_label = 'customer.addresses.update' | t -%}
                {%- assign cancel_label = 'customer.addresses.cancel' | t -%}
                <div class='flex gap-2'>
                  {% render 'button', label: update_label, type: 'submit' %}
                  {% render 'button',
                    label: cancel_label,
                    type: 'button',
                    variant: 'ghost',
                    click_expr: 'openAddress = null'
                  %}
                </div>
              {%- endform -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {% render 'pagination-navigation', paginate: paginate %}
  {%- endpaginate -%}
</div>
